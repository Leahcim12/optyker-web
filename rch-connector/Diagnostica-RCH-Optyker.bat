@echo off
setlocal
title Diagnostica RCH Optyker - sola lettura
echo OPTYKER - DIAGNOSTICA RCH 20260914-busy2
echo Lascia libera la cassa durante la lettura. Nessuno scontrino verra emesso.
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $r=[ordered]@{diagnosticVersion='20260914-busy2';generatedAt=(Get-Date).ToString('o');readOnly=$true;health=$null;diagnostics=$null;connections=@();processes=@();errors=@()}; try { $h=Invoke-RestMethod -UseBasicParsing -Uri 'http://127.0.0.1:8765/health' -TimeoutSec 5; $r.health=$h | Select-Object connector,version,printer,port,capabilities; if($h.connector -ne 'Optyker RCH'){throw 'Servizio locale non riconosciuto'}; $r.diagnostics=Invoke-RestMethod -UseBasicParsing -Uri 'http://127.0.0.1:8765/diagnostics' -TimeoutSec 30 } catch {$r.errors+=('bridge: '+$_.Exception.Message)}; try { $printer=[string]$r.health.printer; $r.connections=@(Get-NetTCPConnection -ErrorAction Stop | Where-Object {$_.LocalPort -eq 8765 -or ($printer -and $_.RemoteAddress -eq $printer)} | Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,State,OwningProcess); $owners=@($r.connections | ForEach-Object {$_.OwningProcess}); $r.processes=@(Get-Process | Where-Object {$owners -contains $_.Id -or $_.ProcessName -match 'rch|optyker|focus|powershell|pwsh'} | Select-Object Id,ProcessName) } catch {$r.errors+=('Windows: '+$_.Exception.Message)}; try { $out=Join-Path ([Environment]::GetFolderPath('Desktop')) ('Diagnostica-RCH-Optyker-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'.json'); $r | ConvertTo-Json -Depth 20 | Set-Content -Encoding UTF8 -LiteralPath $out; Write-Host ('File salvato: '+$out) -ForegroundColor Green; Write-Host 'Allega il file JSON alla chat, anche se contiene errori.'; Write-Host 'Non sono stati emessi documenti o modificati i blocchi locali.' } catch {Write-Host ('Salvataggio fallito: '+$_.Exception.Message) -ForegroundColor Red}; Read-Host 'Premi INVIO per chiudere'"
endlocal
